package GMLibRuntime;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$LIBSUFFIX AUTO}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  dbrtl,
  MapLibCore;

contains
  uGMLib.Google.Types in '..\src\Common\GM\uGMLib.Google.Types.pas',
  uGMLib.Core.Types in '..\src\Common\GM\uGMLib.Core.Types.pas',
  uGMLib.CoordinatePoint in '..\src\Common\GM\uGMLib.CoordinatePoint.pas',
  uGMLib.Circle in '..\src\Common\GM\uGMLib.Circle.pas',
  uGMLib.Elevation in '..\src\Common\GM\uGMLib.Elevation.pas',
  uGMLib.GeoCode in '..\src\Common\GM\uGMLib.GeoCode.pas',
  uGMLib.InfoWindow in '..\src\Common\GM\uGMLib.InfoWindow.pas',
  uGMLib.GroundOverlay in '..\src\Common\GM\uGMLib.GroundOverlay.pas',
  uGMLib.Geometry in '..\src\Common\GM\uGMLib.Geometry.pas',
  uGMLib.Marker in '..\src\Common\GM\uGMLib.Marker.pas',
  uGMLib.Layers in '..\src\Common\GM\uGMLib.Layers.pas',
  uGMLib.MapOptions in '..\src\Common\GM\uGMLib.MapOptions.pas',
  uGMLib.Polygon in '..\src\Common\GM\uGMLib.Polygon.pas',
  uGMLib.Polyline in '..\src\Common\GM\uGMLib.Polyline.pas',
  uGMLib.Map in '..\src\Common\GM\uGMLib.Map.pas',
  uGMLib.Rectangle in '..\src\Common\GM\uGMLib.Rectangle.pas',
  uGMLib.Routes in '..\src\Common\GM\uGMLib.Routes.pas';

end.




