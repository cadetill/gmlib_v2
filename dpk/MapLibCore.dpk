package MapLibCore;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$LIBSUFFIX AUTO}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  IndySystem,
  IndyProtocols,
  IndyCore,
  dbrtl,
  FireDAC,
  FireDACCommonDriver,
  FireDACCommon,
  FireDACSqliteDriver;

contains
  uMapLib.Core.ApiObject in '..\src\Common\uMapLib.Core.ApiObject.pas',
  uMapLib.Core.Bridge in '..\src\Common\uMapLib.Core.Bridge.pas',
  uMapLib.Core.BridgeRegistry in '..\src\Common\uMapLib.Core.BridgeRegistry.pas',
  uMapLib.Core.Component in '..\src\Common\uMapLib.Core.Component.pas',
  uMapLib.Core.Offline in '..\src\Common\uMapLib.Core.Offline.pas',
  uMapLib.Offline.Types in '..\src\Common\uMapLib.Offline.Types.pas',
  uMapLib.Offline.RegionCatalog in '..\src\Common\uMapLib.Offline.RegionCatalog.pas',
  uMapLib.Offline.TileServer in '..\src\Common\uMapLib.Offline.TileServer.pas',
  uMapLib.Offline.TileStore in '..\src\Common\uMapLib.Offline.TileStore.pas',
  uMapLib.Offline.TileCoverage in '..\src\Common\uMapLib.Offline.TileCoverage.pas',
  uMapLib.Offline.RegionManager in '..\src\Common\uMapLib.Offline.RegionManager.pas',
  uMapLib.Offline.StyleProvider in '..\src\Common\uMapLib.Offline.StyleProvider.pas',
  uMapLib.Offline.RemoteTileProvider in '..\src\Common\uMapLib.Offline.RemoteTileProvider.pas',
  uMapLib.Offline.TileResolver in '..\src\Common\uMapLib.Offline.TileResolver.pas',
  uMapLib.Offline.LocalHttpServer in '..\src\Common\uMapLib.Offline.LocalHttpServer.pas',
  uMapLib.Offline.SqliteTileStore in '..\src\Common\uMapLib.Offline.SqliteTileStore.pas',
  uMapLib.Offline.MBTilesTileStore in '..\src\Common\uMapLib.Offline.MBTilesTileStore.pas',
  uMapLib.Offline.MBTilesWriter in '..\src\Common\uMapLib.Offline.MBTilesWriter.pas',
  uMapLib.Offline.RegionBuilder in '..\src\Common\uMapLib.Offline.RegionBuilder.pas',
  uMapLib.Offline.RegionTileStore in '..\src\Common\uMapLib.Offline.RegionTileStore.pas',
  uMapLib.Offline.CompositeTileStore in '..\src\Common\uMapLib.Offline.CompositeTileStore.pas',
  uMapLib.Offline.VectorRuntime in '..\src\Common\uMapLib.Offline.VectorRuntime.pas',
  uMapLib.Offline.Storage in '..\src\Common\uMapLib.Offline.Storage.pas',
  uMapLib.Offline.Downloader in '..\src\Common\uMapLib.Offline.Downloader.pas',
  uMapLib.Core.Messages in '..\src\Common\uMapLib.Core.Messages.pas',
  uMapLib.Core.Types in '..\src\Common\uMapLib.Core.Types.pas',
  uMapLib.Core.LatLng in '..\src\Common\uMapLib.Core.LatLng.pas',
  uGMLib.BootstrapAssets in '..\src\Common\GM\uGMLib.BootstrapAssets.pas',
  uGMLib.Platform.Format in '..\src\Common\GM\uGMLib.Platform.Format.pas';

end.



