package GMLibRuntime.Fmx;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'GMLib Runtime FMX Package'}
{$LIBSUFFIX AUTO}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  fmx,
  GMLibRuntime,
  MapLibCore,
  OSMLibRuntime;

contains
  uGMLib.Fmx.Bridge.WebBrowser in '..\src\Fmx\GM\uGMLib.Fmx.Bridge.WebBrowser.pas',
  uGMLib.Fmx.InfoWindow in '..\src\Fmx\GM\uGMLib.Fmx.InfoWindow.pas',
  uGMLib.Fmx.Marker in '..\src\Fmx\GM\uGMLib.Fmx.Marker.pas',
  uGMLib.Fmx.MapBootstrap in '..\src\Fmx\GM\uGMLib.Fmx.MapBootstrap.pas',
  uGMLib.Fmx.Map in '..\src\Fmx\GM\uGMLib.Fmx.Map.pas',
  uGMLib.Fmx.MapOptions in '..\src\Fmx\GM\uGMLib.Fmx.MapOptions.pas',
  uGMLib.Fmx.Polygon in '..\src\Fmx\GM\uGMLib.Fmx.Polygon.pas',
  uGMLib.Fmx.Polyline in '..\src\Fmx\GM\uGMLib.Fmx.Polyline.pas',
  uGMLib.Fmx.Rectangle in '..\src\Fmx\GM\uGMLib.Fmx.Rectangle.pas',
  uGMLib.Fmx.Circle in '..\src\Fmx\GM\uGMLib.Fmx.Circle.pas',
  uOSMLib.Fmx.Map in '..\src\Fmx\OSM\uOSMLib.Fmx.Map.pas',
  uOSMLib.Fmx.MapBootstrap in '..\src\Fmx\OSM\uOSMLib.Fmx.MapBootstrap.pas';

end.

