<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="GMLibRuntimeLcl"/>
    <Type Value="RunTime"/>
    <Author Value="Xavier Martinez (cadetill)"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <UnitOutputDirectory Value="..\..\build\lazarus\lcl\runtime\units\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <Parsing>
        <SyntaxOptions>
          <AllowLabel Value="False"/>
          <UseAnsiStrings Value="False"/>
        </SyntaxOptions>
      </Parsing>
      <Other>
        <CustomOptions Value="$(IDEBuildOptions)"/>
      </Other>
    </CompilerOptions>
    <Description Value="GMLib runtime package for Lazarus LCL"/>
    <Version Major="1"/>
    <Files Count="7">
      <Item1>
        <Filename Value="uGMLib.Lcl.MapOptions.pas"/>
        <UnitName Value="uGMLib.Lcl.MapOptions"/>
      </Item1>
      <Item2>
        <Filename Value="uGMLib.Lcl.Circle.pas"/>
        <UnitName Value="uGMLib.Lcl.Circle"/>
      </Item2>
      <Item3>
        <Filename Value="uGMLib.Lcl.Polygon.pas"/>
        <UnitName Value="uGMLib.Lcl.Polygon"/>
      </Item3>
      <Item4>
        <Filename Value="uGMLib.Lcl.Rectangle.pas"/>
        <UnitName Value="uGMLib.Lcl.Rectangle"/>
      </Item4>
      <Item5>
        <Filename Value="uGMLib.Lcl.MapBootstrap.pas"/>
        <UnitName Value="uGMLib.Lcl.MapBootstrap"/>
      </Item5>
      <Item6>
        <Filename Value="uGMLib.Lcl.Map.pas"/>
        <UnitName Value="uGMLib.Lcl.Map"/>
      </Item6>
      <Item7>
        <Filename Value="..\Common\uGMLib.BootstrapAssets.pas"/>
        <UnitName Value="uGMLib.BootstrapAssets"/>
      </Item7>
    </Files>
    <RequiredPkgs Count="2">
      <Item1>
        <PackageName Value="GMLibCommon"/>
      </Item1>
      <Item2>
        <PackageName Value="LCL"/>
      </Item2>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <CompatibilityMode Value="True"/>
  </Package>
</CONFIG>
