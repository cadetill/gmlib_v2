<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <PathDelim Value="\"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="True"/>
        <MainUnitHasTitleStatement Value="False"/>
        <MainUnitHasScaledStatement Value="False"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <MainUnit Value="0"/>
      <Title Value="MegaDemo"/>
      <UseAppBundle Value="False"/>
      <ResourceType Value="res"/>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <Units>
      <Unit>
        <Filename Value="MegaDemo.lpr"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="MegaDemo"/>
      </Unit>
      <Unit>
        <Filename Value="src\UMainFrm.pas"/>
        <IsPartOfProject Value="True"/>
        <HasForm Value="True"/>
        <UnitName Value="UMainFrm"/>
      </Unit>
    </Units>
    <RequiredPackages>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
      <Item>
        <PackageName Value="GMLibRuntime.Lcl"/>
      </Item>
    </RequiredPackages>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="12"/>
    <SearchPaths>
      <OtherUnitFiles Value="src;..\..\..\src\Common;..\..\..\src\Common\GM;..\..\..\src\Common\OSM;..\..\..\src\Lcl;..\..\..\src\Lcl\GM;..\..\..\src\Lcl\OSM"/>
      <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Parsing>
      <SyntaxMode Value="3"/>
    </Parsing>
    <CodeGeneration>
      <TargetOSDefault Value="Win64"/>
    </CodeGeneration>
  </CompilerOptions>
</CONFIG>
