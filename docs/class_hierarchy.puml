            TOwnedCollection <|-- TGMRectangles
            TGMRectangleOptions <|-- TGMRectangleItem

            TGMRectangleOptions --> TGMLatLngBounds
            TGMRectangles --> TGMRectangleItem
        }

        package "Circle" {
            class TGMCircleOptions
            class TGMCircleItem
            class TGMCircles

            TGMLibApiObject <|-- TGMCircleOptions
            TCollectionItem <|-- TGMCircleItem
            TOwnedCollection <|-- TGMCircles
            TGMCircleOptions <|-- TGMCircleItem

            TGMCircleOptions --> TGMLibLatLngAlias
            TGMCircles --> TGMCircleItem
        }

        package "GroundOverlay" {
            class TGMGroundOverlayOptions
            class TGMGroundOverlayItem
            class TGMGroundOverlays

            TGMLibApiObject <|-- TGMGroundOverlayOptions
