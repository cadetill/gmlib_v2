            TCollectionItem <|-- TGMRouteWaypoint
            TOwnedCollection <|-- TGMRouteWaypoints
            TMapLibComponent <|-- TGMRoutes

            TGMRouteWaypoint --> TGMLibLatLngAlias
            TGMRouteWaypoints --> TGMRouteWaypoint
            TGMRouteQueryResult --> TGMPolylineOptions
            TGMRouteQuery --> TGMRouteQueryResult
            TGMRoutes --> TGMRouteQuery
            TGMRoutes --> TGMRouteWaypoints
            TGMRoutes --> TGMPolylinePath
            TGMRoutes --> TGMLibLatLngAlias
        }
    }

    package "OSM (OpenStreetMap)" {
        class TOSMMap
        TMapLibComponent <|-- TOSMMap
    }
}

