            TGMPolygonPath <|-- TGMPolygonOptions

            TGMPolygonOptions --> TGMPolygonPath
            TGMPolygonPath --> TGMPolygonPoint
            TGMPolygons --> TGMPolygonItem
        }

        package "Rectangle" {
            class TGMRectangleOptions
            class TGMRectangleItem
            class TGMRectangles

            TGMLibApiObject <|-- TGMRectangleOptions
