            TGMCustomPositionControlOptions <|-- TGMZoomControlOptions
            TGMLibApiObject <|-- TGMScaleControlOptions
            TGMLibApiObject <|-- TGMLatLngBounds
            TGMLibApiObject <|-- TGMMapRestriction
            TGMLibApiObject <|-- TGMMapOptions

            TGMMapOptions --> TGMCustomPositionControlOptions
            TGMMapOptions --> TGMMapTypeControlOptions
            TGMMapOptions --> TGMFullscreenControlOptions
            TGMMapOptions --> TGMCameraControlOptions
            TGMMapOptions --> TGMRotateControlOptions
            TGMMapOptions --> TGMStreetViewControlOptions
            TGMMapOptions --> TGMZoomControlOptions
