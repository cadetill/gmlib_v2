            TGMLibApiObject <|-- TGMPinOptions
            TGMLibApiObject <|-- TGMHtmlMarkerOptions
            TGMLibApiObject <|-- TGMLabelMarkerOptions
            TGMLibApiObject <|-- TGMMarkerOptions
