            TMapLibComponent <|-- TGMGeoCode
            TGMGeoCode --> TGMGeocodePendingRequest
            TGMGeoCode --> TGMLatLngBounds
            TGMGeoCode --> TGMLibLatLngAlias
        }

        package "Elevation" {
            class TGMElevationPendingRequest
