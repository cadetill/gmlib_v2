        package "Options" {
            class TGMCustomPositionControlOptions
            class TGMMapTypeControlOptions
            class TGMFullscreenControlOptions
            class TGMCameraControlOptions
            class TGMRotateControlOptions
            class TGMStreetViewControlOptions
            class TGMZoomControlOptions
            class TGMScaleControlOptions
            class TGMLatLngBounds
            class TGMMapRestriction
            class TGMMapOptions

