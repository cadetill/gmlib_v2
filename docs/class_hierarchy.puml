            TGMGroundOverlayOptions <|-- TGMGroundOverlayItem

            TGMGroundOverlayOptions --> TGMLatLngBounds
            TGMGroundOverlays --> TGMGroundOverlayItem
        }

        package "GeoCode" {
            class TGMGeocodePendingRequest
