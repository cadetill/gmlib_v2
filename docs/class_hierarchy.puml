@startuml
skinparam ClassBorderColor #000000
skinparam ClassArrowColor #000000
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12

title GMLib v2 Class Hierarchy

package "Common" {

    package "MapLib Core" {
        class TMapLibApiObject
        class TMapLibComponent
        interface IMapBridgeTransport
        class TMapLibLatLng
        class TMapLibMessageEnvelope
        class TGMLibBootstrapAssets
        class TMapBridgeFactory
        class TGMLibApiObject
        class TGMLibComponent
        interface IGMMapViewportHost
        enum TGMObjectId
        enum TGMBridgeBackend
        enum TGMChangeOrigin

        TComponent <|-- TMapLibComponent
        TMapLibApiObject <|-- TGMLibApiObject
        TMapLibComponent <|-- TGMLibComponent
        TMapLibApiObject <|-- TMapLibLatLng
        IGMMapViewportHost <|.. TGMCustomMap

        TGMLibApiObject <|-- TGMLibBootstrapAssets

        TMapBridgeFactory -[hidden]-> IMapBridgeTransport
    }

    package "Google Maps (GM)" {

        package "Core" {
            class TGMCustomMapLinkedComponent
            class TGMCustomMap

            TGMLibComponent <|-- TGMCustomMapLinkedComponent
            TGMLibComponent <|-- TGMCustomMap
            IGMMapViewportHost <|.. TGMCustomMap

            class TGMLibLatLngAlias << (A,lightgrey) TMapLibLatLng >>
            TMapLibLatLng <|-- TGMLibLatLngAlias : (Alias)

            class TGMObjectIdAlias << (A,lightgrey) TGMObjectId >>
            TGMObjectId <|-- TGMObjectIdAlias : (Alias)

            class TGMBridgeBackendAlias << (A,lightgrey) TGMBridgeBackend >>
            TGMBridgeBackend <|-- TGMBridgeBackendAlias : (Alias)

            class TGMMapId << (A,lightgrey) string >>

            enum TGMMapTypeId
            class TGMMapTypeIds << (A,lightgrey) set of TGMMapTypeId >>

            enum TGMControlPosition
            enum TGMMapTypeControlStyle
            enum TGMGestureHandling
            enum TGMScaleControlStyle
            enum TGMColorScheme
            enum TGMRenderingType
            enum TGMCollisionBehavior
            enum TGMMarkerContentMode
