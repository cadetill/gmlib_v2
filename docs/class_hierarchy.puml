            TGMLayers --> TGMTransitLayer
            TGMLayers --> TGMBicyclingLayer
            TGMLayers --> TGMKmlLayer
        }

        package "Marker" {
            class TGMPinOptions
            class TGMHtmlMarkerOptions
            class TGMLabelMarkerOptions
            class TGMMarkerOptions
            class TGMMarkerItem
            class TGMMarkers
